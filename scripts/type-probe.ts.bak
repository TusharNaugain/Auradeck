const Fields = ContactSchema.shape
void null as unknown as z.infer<typeof Fields.firstName>
void null as unknown as z.infer<typeof Fields.lastName>
void null as unknown as z.infer<typeof Fields.email>
void null as unknown as z.infer<typeof Fields.phone>
void null as unknown as z.infer<typeof Fields.whatsappNumber>
void null as unknown as z.infer<typeof Fields.organisationName>
void null as unknown as z.infer<typeof Fields.jobTitle>
void null as unknown as z.infer<typeof Fields.website>
void null as unknown as z.infer<typeof Fields.city>
void null as unknown as z.infer<typeof Fields.state>
void null as unknown as z.infer<typeof Fields.country>
void null as unknown as z.infer<typeof Fields.leadSource>
void null as unknown as z.infer<typeof Fields.sourceDetail>
void null as unknown as z.infer<typeof Fields.campaignId>
void null as unknown as z.infer<typeof Fields.qualificationStatus>
void null as unknown as z.infer<typeof Fields.estimatedPracticeSize>
void null as unknown as z.infer<typeof Fields.estimatedUsers>
void null as unknown as z.infer<typeof Fields.currentSoftware>
void null as unknown as z.infer<typeof Fields.painPoints>
void null as unknown as z.infer<typeof Fields.useCase>
void null as unknown as z.infer<typeof Fields.budgetRange>
void null as unknown as z.infer<typeof Fields.expectedTimeline>
void null as unknown as z.infer<typeof Fields.preferredContactMethod>
void null as unknown as z.infer<typeof Fields.assignedToUserId>
void null as unknown as z.infer<typeof Fields.assignedTeamId>
void null as unknown as z.infer<typeof Fields.nextFollowUpAt>
void null as unknown as z.infer<typeof Fields.consentStatus>
