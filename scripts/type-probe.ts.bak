/* Type probe 2 — bisect which composition breaks z.infer */
import { z } from 'zod'
import { safeText, tagsSchema, customFieldsSchema, emailSchema, phoneSchema } from '@/lib/validations/common'

const A = z.object({ firstName: safeText(50) })
type A = z.infer<typeof A>
const a: A = null as never
const aField: string = a.firstName

const B = z.object({ firstName: safeText(50), tags: tagsSchema })
type B = z.infer<typeof B>
const b: B = null as never

const C = z.object({ firstName: safeText(50), tags: tagsSchema, customFields: customFieldsSchema })
type C = z.infer<typeof C>

const D = z.object({ email: emailSchema.optional(), phone: phoneSchema.optional() }).superRefine((_, __) => {})
const D_shadow = z.object({ email: emailSchema.optional(), phone: phoneSchema.optional() }).superRefine((d, ctx) => {
  if (!d.email && !d.phone) {
    ctx.addIssue({ code: z.ZodIssueCode.custom, message: 'x' })
  }
})
void a
void aField
void b
type Shadow_A = A
void null as unknown as Shadow_A
void null as unknown as B
void null as unknown as C
void null as unknown as ReturnType<typeof D.parse>
void null as unknown as ReturnType<typeof D_shadow.parse>

// Probe crm module's own contact schema: which single field breaks infer? Try building the same object piecemeal.
