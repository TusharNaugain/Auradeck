# =============================================================================
# AuraDeck CRM — Environment Variables
# Copy this file to .env.local for local development
# Never commit .env.local or any file containing real secrets
# =============================================================================

# --- Application ---
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=AuraDeck CRM
# Opt-in sample workspace. Keep false when using real customer data.
NEXT_PUBLIC_DEMO_MODE=false

# --- Database (PostgreSQL) ---
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/auradeck_crm

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Firebase Firestore (server-side) ---
# Set up Firestore in this Firebase project and configure Application Default
# Credentials (GOOGLE_APPLICATION_CREDENTIALS locally or workload identity in production).
FIREBASE_PROJECT_ID=auradesk-ddf2b

# --- Session Secret (min 32 chars, random) ---
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters

# --- Auth ---
# Iron-session password (min 32 chars)
IRON_SESSION_PASSWORD=replace-with-a-random-password-at-least-32-characters

# --- Email Provider ---
# Provider: "resend" | "postmark" | "smtp"
EMAIL_PROVIDER=smtp
EMAIL_FROM_ADDRESS=noreply@auradeck.in
EMAIL_FROM_NAME=AuraDeck CRM

# Resend
RESEND_API_KEY=

# Postmark
POSTMARK_SERVER_TOKEN=

# SMTP
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# --- Google OAuth ---
# Create a Google OAuth Web client and register this exact local redirect URI:
# http://localhost:3000/api/auth/google/callback
# Google sign-in only grants access to an existing active internal-team member.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Logging ---
# Log level: debug | info | warn | error
LOG_LEVEL=info

# --- Rate Limiting ---
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=300

# --- Seed Config (local development only) ---
SEED_ADMIN_PASSWORD=
SEED_USER_PASSWORD=

# --- Security ---
CSRF_SECRET=change-me-to-random-csrf-secret-32-chars-min
ALLOWED_ORIGINS=http://localhost:3000

# --- Sheet <-> CRM sync ---
# Shared secret the sheet script signs requests with (min 32 chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SYNC_SHARED_SECRET=
# The organisation whose leads the sheet syncs with.
SYNC_ORGANISATION_ID=
# When BOTH sides edit the same field: "crm" (default) or "sheet" wins. The loser is always saved in sync_conflicts.
SYNC_CONFLICT_WINNER=crm
