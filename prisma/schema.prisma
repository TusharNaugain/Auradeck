// ---------- Sheet <-> CRM sync ----------

/// Last state both sides agreed on, per synced record (the merge base).
model SyncRecordState {
  id             String   @id @default(cuid())
  organisationId String
  entity         String
  recordId       String
  /// Stable id the sheet generated for a row it created; makes creates idempotent.
  externalRef    String?
  baseJson       Json     @default("{}")
  lastSyncedAt   DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organisationId, entity, recordId])
  @@unique([organisationId, entity, externalRef])
  @@index([organisationId])
  @@map("sync_record_states")
}

/// Untouched copy of every inbound batch, kept before processing starts.
model SyncBatch {
  id             String   @id @default(cuid())
  organisationId String
  batchId        String
  status         String   @default("received")
  rawPayload     Json
  resultJson     Json?
  createdAt      DateTime @default(now())
  completedAt    DateTime?

  @@unique([organisationId, batchId])
  @@index([organisationId, createdAt])
  @@map("sync_batches")
}

/// Both sides changed the same field. The losing value is kept here, never dropped.
model SyncConflict {
  id             String    @id @default(cuid())
  organisationId String
  entity         String
  recordId       String
  field          String
  crmValue       Json?
  sheetValue     Json?
  winner         String
  status         String    @default("open")
  createdAt      DateTime  @default(now())
  resolvedAt     DateTime?

  @@index([organisationId, status])
  @@index([recordId])
  @@map("sync_conflicts")
}

/// Rows that failed validation or were halted, with the reason and the original row.
model SyncRejectedRow {
  id             String   @id @default(cuid())
  organisationId String
  batchId        String
  rowRef         String
  reason         String
  rawRow         Json?
  createdAt      DateTime @default(now())

  @@index([organisationId, createdAt])
  @@index([batchId])
  @@map("sync_rejected_rows")
}

// ---------- Email campaigns (Resend Broadcasts) ----------

model CampaignSend {
  id                String       @id @default(cuid())
  organisationId    String
  createdByUserId   String
  subject           String
  message           String       @db.Text
  audience          String
  recipientCount    Int
  /// queued | syncing | sending | sent | failed
  status            String       @default("queued")
  resendSegmentId   String?
  resendBroadcastId String?
  error             String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  completedAt       DateTime?

  organisation      Organisation @relation(fields: [organisationId], references: [id])

  @@index([organisationId, createdAt])
  @@map("campaign_sends")
}
